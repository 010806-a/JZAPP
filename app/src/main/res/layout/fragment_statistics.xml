<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background"
     android:orientation="vertical">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="match_parent"
         android:paddingEnd="16dp"
         android:orientation="vertical"
         android:paddingStart="16dp"
         android:paddingTop="12dp">

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="25sp"
             android:textColor="@color/text_primary"
             android:text="统计"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="13sp"
             android:textColor="@color/text_secondary"
             android:layout_marginTop="3dp"
             android:text="看懂每一笔 · 掌握消费趋势" />

        <LinearLayout
             android:layout_height="40dp"
             android:layout_width="wrap_content"
             android:paddingEnd="8dp"
             android:gravity="center_vertical"
             android:clickable="true"
             android:orientation="horizontal"
             android:paddingStart="12dp"
             android:focusable="true"
             android:id="@+id/monthSelector">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="15sp"
                 android:textColor="@android:color/black"
                 android:id="@+id/tvMonth"
                 android:text="2026年9月"
                 android:textStyle="bold" />

            <ImageView
                 android:layout_height="16dp"
                 android:layout_width="16dp"
                 android:src="@drawable/ic_arrow_down"
                 android:contentDescription="选择月份"
                 android:layout_marginStart="4dp"
                 android:id="@+id/ivMonthArrow" />

        </LinearLayout>

    </LinearLayout>

    <ScrollView
         android:layout_height="0dp"
         android:layout_width="match_parent"
         android:scrollbars="none"
         android:fillViewport="true"
         android:clipToPadding="false"
         android:layout_weight="1">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="match_parent"
             android:paddingEnd="16dp"
             android:orientation="vertical"
             android:paddingBottom="28dp"
             android:paddingStart="16dp">

            <com.google.android.material.card.MaterialCardView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 app:cardElevation="0dp"
                 app:strokeWidth="0dp"
                 app:cardBackgroundColor="@color/primary"
                 app:cardCornerRadius="20dp">

   <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="本月收支"
    android:textColor="@android:color/white"
    android:textSize="15sp"
    android:textStyle="bold" />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:text="本月结余"
    android:textColor="#B8C4FF"
    android:textSize="11sp" />

<TextView
    android:id="@+id/tvBalance"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:text="¥0.00"
    android:textColor="@android:color/white"
    android:textSize="30sp"
    android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- 本月收入 -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月收入"
                android:textColor="#B8C4FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTotalIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="¥0.00"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 分隔线 -->

        <View
            android:layout_width="1dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:background="#55FFFFFF" />

        <!-- 本月支出 -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="本月支出"
                android:textColor="#B8C4FF"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvTotalExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="¥0.00"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="18dp">

                <TextView
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:textSize="17sp"
                     android:textColor="@color/text_primary"
                     android:layout_weight="1"
                     android:text="收支趋势"
                     android:textStyle="bold" />
<TextView
     android:id="@+id/tvTrendPeriod"
     android:layout_width="wrap_content"
     android:layout_height="36dp"
     android:gravity="center"
     android:minWidth="56dp"
     android:paddingStart="12dp"
     android:paddingEnd="12dp"
     android:text="按日"
     android:textColor="@color/text_secondary"
     android:textSize="12sp"
     android:clickable="true"
     android:focusable="true" />

            </LinearLayout>

            <LinearLayout
                 android:layout_height="36dp"
                 android:layout_width="match_parent"
                 android:orientation="horizontal"
                 android:layout_marginTop="10dp"
                 android:id="@+id/trendTabs">

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 app:cardElevation="0dp"
                 app:strokeWidth="0dp"
                 app:cardBackgroundColor="@android:color/white"
                 android:layout_marginTop="10dp"
                 app:cardCornerRadius="20dp">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:padding="18dp"
                     android:orientation="vertical">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:gravity="center_vertical"
                         android:orientation="horizontal">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:orientation="vertical"
                             android:layout_weight="1">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="13sp"
                                 android:textColor="@color/text_secondary"
                                 android:id="@+id/tvTrendLabel"
                                 android:text="本月支出" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="23sp"
                                 android:textColor="@color/text_primary"
                                 android:layout_marginTop="4dp"
                                 android:id="@+id/tvTrendValue"
                                 android:text="¥0.00"
                                 android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:paddingEnd="8dp"
                             android:background="@drawable/bg_bill_summary_clip"
                             android:paddingBottom="5dp"
                             android:textSize="10sp"
                             android:textColor="@color/text_secondary"
                             android:paddingStart="8dp"
                             android:id="@+id/tvTrendChange"
                             android:paddingTop="5dp"
                             android:text="较上月" />

                    </LinearLayout>

                    <com.github.mikephil.charting.charts.LineChart
                         android:layout_height="180dp"
                         android:layout_width="match_parent"
                         android:layout_marginTop="12dp"
                         android:id="@+id/expenseTrendChart" />

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:orientation="horizontal"
                         android:layout_marginTop="4dp"
                         android:id="@+id/dailySummaryLayout">

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:gravity="center"
                             android:orientation="vertical"
                             android:layout_weight="1">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="11sp"
                                 android:textColor="@color/text_secondary"
                                 android:text="日均" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="15sp"
                                 android:textColor="@color/text_primary"
                                 android:layout_marginTop="3dp"
                                 android:id="@+id/tvDailyAverage"
                                 android:text="¥0.00"
                                 android:textStyle="bold" />

                        </LinearLayout>

                        <View
                             android:layout_height="30dp"
                             android:layout_width="1dp"
                             android:background="@color/background"
                             android:layout_gravity="center" />

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:gravity="center"
                             android:orientation="vertical"
                             android:layout_weight="1">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="11sp"
                                 android:textColor="@color/text_secondary"
                                 android:text="最高日" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="15sp"
                                 android:textColor="@color/text_primary"
                                 android:layout_marginTop="3dp"
                                 android:id="@+id/tvHighestDaily"
                                 android:text="¥0.00"
                                 android:textStyle="bold" />

                        </LinearLayout>

                        <View
                             android:layout_height="30dp"
                             android:layout_width="1dp"
                             android:background="@color/background"
                             android:layout_gravity="center" />

                        <LinearLayout
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:gravity="center"
                             android:orientation="vertical"
                             android:layout_weight="1">

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="11sp"
                                 android:textColor="@color/text_secondary"
                                 android:text="最高日" />

                            <TextView
                                 android:layout_height="wrap_content"
                                 android:layout_width="wrap_content"
                                 android:textSize="15sp"
                                 android:textColor="@color/text_primary"
                                 android:layout_marginTop="3dp"
                                 android:id="@+id/tvHighestDailyDate"
                                 android:text="暂无"
                                 android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="18dp">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:orientation="vertical"
                     android:layout_weight="1">

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="17sp"
                         android:textColor="@color/text_primary"
                         android:text="支出分类"
                         android:textStyle="bold" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:textSize="12sp"
                         android:textColor="@color/text_secondary"
                         android:layout_marginTop="3dp"
                         android:text="看看钱主要花在哪里" />

                </LinearLayout>

                <ImageView
                     android:layout_height="28dp"
                     android:layout_width="28dp"
                     android:contentDescription="分类统计"
                     android:src="@drawable/ic_statistics_a" />

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 app:cardElevation="0dp"
                 app:strokeWidth="0dp"
                 app:cardBackgroundColor="@android:color/white"
                 android:layout_marginTop="10dp"
                 app:cardCornerRadius="20dp">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="match_parent"
                     android:padding="18dp"
                     android:orientation="vertical">

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:gravity="center_vertical"
                         android:orientation="horizontal">

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="0dp"
                             android:textSize="12sp"
                             android:textColor="@color/text_secondary"
                             android:layout_weight="1"
                             android:text="本月支出" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="17sp"
                             android:textColor="@color/text_primary"
                             android:id="@+id/tvCategoryTotal"
                             android:text="¥0.00"
                             android:textStyle="bold" />

                    </LinearLayout>

                    <com.github.mikephil.charting.charts.PieChart
                         android:layout_height="230dp"
                         android:layout_width="match_parent"
                         android:layout_marginTop="2dp"
                         android:id="@+id/pieChart" />

                    <TextView
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:visibility="gone"
                         android:gravity="center"
                         android:paddingBottom="30dp"
                         android:textSize="13sp"
                         android:textColor="@color/text_secondary"
                         android:id="@+id/tvCategoryEmpty"
                         android:paddingTop="30dp"
                         android:text="本月暂无支出" />

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="match_parent"
                         android:orientation="vertical"
                         android:id="@+id/layoutCategoryStatistics">

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>