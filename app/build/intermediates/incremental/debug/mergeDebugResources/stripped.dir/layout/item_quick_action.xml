<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     android:layout_height="88dp"
     android:layout_width="76dp"
     android:layout_marginEnd="8dp">

    <FrameLayout
         android:layout_height="82dp"
         android:layout_width="72dp"
         android:background="@drawable/bg_quick_action"
         android:clickable="true"
         android:focusable="true"
         android:id="@+id/cardQuickAction"
         android:layout_gravity="top|start"
         android:foreground="?attr/selectableItemBackground">

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:gravity="center"
             android:padding="6dp"
             android:orientation="vertical">

            <ImageView
                 android:layout_height="32dp"
                 android:layout_width="32dp"
                 android:contentDescription="@null"
                 android:scaleType="centerInside"
                 android:id="@+id/ivQuickActionIcon" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="match_parent"
                 android:gravity="center"
                 android:ellipsize="end"
                 android:textSize="11sp"
                 android:textColor="@color/text_primary"
                 android:layout_marginTop="5dp"
                 android:maxLines="1"
                 android:id="@+id/tvQuickActionTitle" />

        </LinearLayout>

    </FrameLayout>

    <TextView
         android:layout_height="22dp"
         android:layout_width="22dp"
         android:visibility="gone"
         android:background="@drawable/bg_quick_action_delete"
         android:gravity="center"
         android:textSize="16sp"
         android:textColor="@android:color/white"
         android:id="@+id/tvDeleteBadge"
         android:layout_gravity="top|end"
         android:text="−"
         android:textStyle="bold" />

</FrameLayout>