<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:app="http://schemas.android.com/apk/res-auto"
     android:layout_height="match_parent"
     android:layout_width="match_parent"
     android:background="@color/background">

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="0dp"
         android:layout_marginEnd="16dp"
         android:gravity="center_vertical"
         app:layout_constraintTop_toTopOf="parent"
         android:orientation="horizontal"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintEnd_toEndOf="parent"
         android:layout_marginTop="12dp"
         android:layout_marginStart="16dp"
         android:id="@+id/layoutHeader">

        <LinearLayout
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             android:orientation="vertical"
             android:layout_weight="1">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="24sp"
                 android:textColor="@color/text_primary"
                 android:id="@+id/tvTitle"
                 android:text="账单"
                 android:textStyle="bold" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="14sp"
                 android:textColor="@color/text_secondary"
                 android:layout_marginTop="1dp"
                 android:text="记录每一笔 · 让生活更清晰" />

            <LinearLayout
                 android:layout_height="36dp"
                 android:layout_width="wrap_content"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="2dp">

                <TextView
                     android:layout_height="match_parent"
                     android:layout_width="wrap_content"
                     android:background="?attr/selectableItemBackgroundBorderless"
                     android:gravity="center_vertical"
                     android:clickable="true"
                     android:textSize="17sp"
                     android:textColor="@color/text_primary"
                     android:focusable="true"
                     android:id="@+id/tvMonth"
                     android:text="2026年9月"
                     android:textStyle="bold" />

                <ImageView
                     android:layout_height="16dp"
                     android:layout_width="16dp"
                     android:contentDescription="选择月份"
                     android:src="@drawable/ic_arrow_down"
                     android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
             android:layout_height="40dp"
             android:layout_width="wrap_content"
             android:paddingEnd="16dp"
             android:background="@drawable/bg_import_bill_button"
             android:gravity="center_vertical"
             android:clickable="true"
             android:orientation="horizontal"
             android:paddingStart="14dp"
             android:focusable="true"
             android:minWidth="0dp"
             android:id="@+id/btnImportBill">

            <ImageView
                 android:layout_height="22dp"
                 android:layout_width="22dp"
                 android:contentDescription="账单导入"
                 android:scaleType="centerInside"
                 android:src="@drawable/ic_file_import" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="13sp"
                 android:textColor="@color/text_primary"
                 android:layout_marginStart="6dp"
                 android:text="账单导入"
                 android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
         android:layout_height="158dp"
         android:layout_width="0dp"
         android:layout_marginEnd="16dp"
         android:background="@drawable/bg_bill_summary_clip"
         app:layout_constraintStart_toStartOf="parent"
         android:clipToOutline="true"
         app:layout_constraintEnd_toEndOf="parent"
         android:layout_marginTop="10dp"
         android:layout_marginStart="16dp"
         app:layout_constraintTop_toBottomOf="@id/layoutHeader"
         android:id="@+id/cardSummary">

        <ImageView
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:contentDescription="本月收支背景"
             android:scaleType="fitXY"
             android:src="@drawable/bg_home_money_a" />

        <LinearLayout
             android:layout_height="match_parent"
             android:layout_width="match_parent"
             android:paddingEnd="20dp"
             android:orientation="vertical"
             android:paddingBottom="22dp"
             android:paddingStart="20dp"
             android:paddingTop="22dp">

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="17sp"
                 android:textColor="@color/surface"
                 android:text="本月收支"
                 android:textStyle="bold" />

            <LinearLayout
                 android:layout_height="0dp"
                 android:layout_width="match_parent"
                 android:gravity="center_vertical"
                 android:orientation="horizontal"
                 android:layout_marginTop="10dp"
                 android:layout_weight="1">

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center_vertical"
                     android:orientation="horizontal"
                     android:layout_weight="1">

                    <ImageView
                         android:layout_height="44dp"
                         android:layout_width="44dp"
                         android:contentDescription="支出"
                         android:scaleType="centerInside"
                         android:src="@drawable/ic_expense" />

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:orientation="vertical"
                         android:layout_marginStart="10dp">

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="13sp"
                             android:textColor="@color/surface"
                             android:text="本月支出" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="23sp"
                             android:textColor="@color/surface"
                             android:layout_marginTop="5dp"
                             android:id="@+id/tvExpense"
                             android:text="¥0.00"
                             android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

                <View
                     android:layout_height="64dp"
                     android:layout_width="1dp"
                     android:background="#66FFFFFF" />

                <LinearLayout
                     android:layout_height="wrap_content"
                     android:layout_width="0dp"
                     android:gravity="center_vertical"
                     android:orientation="horizontal"
                     android:paddingStart="18dp"
                     android:layout_weight="1">

                    <ImageView
                         android:layout_height="44dp"
                         android:layout_width="44dp"
                         android:contentDescription="收入"
                         android:scaleType="centerInside"
                         android:src="@drawable/ic_income" />

                    <LinearLayout
                         android:layout_height="wrap_content"
                         android:layout_width="wrap_content"
                         android:orientation="vertical"
                         android:layout_marginStart="10dp">

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="13sp"
                             android:textColor="@color/surface"
                             android:text="本月收入" />

                        <TextView
                             android:layout_height="wrap_content"
                             android:layout_width="wrap_content"
                             android:textSize="23sp"
                             android:textColor="@color/surface"
                             android:layout_marginTop="5dp"
                             android:id="@+id/tvIncome"
                             android:text="¥0.00"
                             android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

    <LinearLayout
         android:layout_height="48dp"
         android:layout_width="0dp"
         android:layout_marginEnd="16dp"
         android:gravity="center_vertical"
         android:orientation="horizontal"
         app:layout_constraintStart_toStartOf="parent"
         app:layout_constraintEnd_toEndOf="parent"
         android:layout_marginTop="8dp"
         android:layout_marginStart="16dp"
         app:layout_constraintTop_toBottomOf="@id/cardSummary"
         android:id="@+id/filterRow">

        <com.google.android.material.chip.ChipGroup
             android:layout_height="wrap_content"
             android:layout_width="0dp"
             app:chipSpacingVertical="0dp"
             app:singleSelection="true"
             app:chipSpacingHorizontal="8dp"
             app:selectionRequired="true"
             android:layout_weight="1"
             android:id="@+id/chipGroup">

            <com.google.android.material.chip.Chip
                 android:layout_height="36dp"
                 android:layout_width="wrap_content"
                 android:checkable="true"
                 app:chipCornerRadius="18dp"
                 android:clickable="true"
                 android:textSize="13sp"
                 android:textColor="@color/bill_filter_chip_text"
                 app:chipStrokeColor="@color/bill_filter_chip_stroke"
                 app:chipStrokeWidth="1dp"
                 app:checkedIconVisible="false"
                 android:checked="true"
                 app:chipBackgroundColor="@color/bill_filter_chip_bg"
                 android:id="@+id/chipAll"
                 android:text="全部" />

            <com.google.android.material.chip.Chip
                 android:layout_height="36dp"
                 android:layout_width="wrap_content"
                 android:checkable="true"
                 app:chipCornerRadius="18dp"
                 android:clickable="true"
                 android:textSize="13sp"
                 android:textColor="@color/bill_filter_chip_text"
                 app:chipStrokeColor="@color/bill_filter_chip_stroke"
                 app:chipStrokeWidth="1dp"
                 app:checkedIconVisible="false"
                 app:chipBackgroundColor="@color/bill_filter_chip_bg"
                 android:id="@+id/chipExpense"
                 android:text="支出" />

            <com.google.android.material.chip.Chip
                 android:layout_height="36dp"
                 android:layout_width="wrap_content"
                 android:checkable="true"
                 app:chipCornerRadius="18dp"
                 android:clickable="true"
                 android:textSize="13sp"
                 android:textColor="@color/bill_filter_chip_text"
                 app:chipStrokeColor="@color/bill_filter_chip_stroke"
                 app:chipStrokeWidth="1dp"
                 app:checkedIconVisible="false"
                 app:chipBackgroundColor="@color/bill_filter_chip_bg"
                 android:id="@+id/chipIncome"
                 android:text="收入" />

        </com.google.android.material.chip.ChipGroup>

        <LinearLayout
             android:layout_height="40dp"
             android:layout_width="wrap_content"
             android:background="?attr/selectableItemBackgroundBorderless"
             android:gravity="center_vertical"
             android:clickable="true"
             android:orientation="horizontal"
             android:paddingStart="6dp"
             android:focusable="true"
             android:id="@+id/btnFilter">

            <ImageView
                 android:layout_height="18dp"
                 android:layout_width="18dp"
                 android:contentDescription="筛选"
                 android:scaleType="centerInside"
                 android:src="@drawable/sx"
                 android:id="@+id/ivFilterIcon" />

            <TextView
                 android:layout_height="wrap_content"
                 android:layout_width="wrap_content"
                 android:textSize="13sp"
                 android:textColor="@color/text_primary"
                 android:layout_marginStart="4dp"
                 android:id="@+id/tvFilterLabel"
                 android:text="筛选" />

            <ImageView
                 android:layout_height="16dp"
                 android:layout_width="16dp"
                 android:contentDescription="进入筛选"
                 android:scaleType="centerInside"
                 android:src="@drawable/ic_arrow_right"
                 android:layout_marginStart="3dp" />

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
         android:layout_height="0dp"
         android:layout_width="0dp"
         android:clipToPadding="false"
         android:paddingStart="16dp"
         app:layout_constraintBottom_toBottomOf="parent"
         app:layout_constraintTop_toBottomOf="@id/filterRow"
         android:paddingEnd="16dp"
         app:layout_constraintStart_toStartOf="parent"
         android:paddingBottom="100dp"
         app:layout_constraintEnd_toEndOf="parent"
         android:id="@+id/recyclerBills"
         android:overScrollMode="never"
         android:paddingTop="2dp" />

    <LinearLayout
         android:layout_height="wrap_content"
         android:layout_width="0dp"
         android:visibility="gone"
         android:gravity="center"
         app:layout_constraintTop_toTopOf="@id/recyclerBills"
         android:orientation="vertical"
         app:layout_constraintStart_toStartOf="@id/recyclerBills"
         app:layout_constraintEnd_toEndOf="@id/recyclerBills"
         app:layout_constraintBottom_toBottomOf="@id/recyclerBills"
         android:id="@+id/emptyView">

        <ImageView
             android:layout_height="72dp"
             android:layout_width="72dp"
             android:contentDescription="@null"
             android:scaleType="centerInside"
             android:src="@drawable/ic_empty_bill" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="17sp"
             android:textColor="@color/text_primary"
             android:layout_marginTop="12dp"
             android:id="@+id/tvEmptyTitle"
             android:text="当前页面暂无账单"
             android:textStyle="bold" />

        <TextView
             android:layout_height="wrap_content"
             android:layout_width="wrap_content"
             android:textSize="13sp"
             android:textColor="@color/text_secondary"
             android:layout_marginTop="5dp"
             android:id="@+id/tvEmptySubtitle"
             android:text="记录第一笔账单，让生活更清晰" />

    </LinearLayout>

    <ImageView
         android:layout_height="56dp"
         android:layout_width="56dp"
         android:layout_marginBottom="18dp"
         android:layout_marginEnd="18dp"
         android:contentDescription="添加账单"
         android:scaleType="centerInside"
         android:src="@drawable/ic_add_ab"
         android:clickable="true"
         app:layout_constraintEnd_toEndOf="parent"
         app:layout_constraintBottom_toBottomOf="parent"
         android:focusable="true"
         android:id="@+id/fabAddBill" />

</androidx.constraintlayout.widget.ConstraintLayout>